#!/bin/sh
set -eu
case "${2:-}" in
  https://github.com/cocodedk/*|git@github.com:cocodedk/*|ssh://git@github.com/cocodedk/*) ;;
  *) echo 'pre-push: destination must be under github.com/cocodedk.' >&2; exit 1 ;;
esac
zero='0000000000000000000000000000000000000000'
has_updates=false
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master|refs/heads/trunk|refs/heads/production|refs/heads/prod|refs/heads/release|refs/heads/release/*)
      if [ "$local_sha" = "$zero" ]; then
        echo "pre-push: deletion of $remote_ref is blocked." >&2
        exit 1
      fi
      if [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
        echo "pre-push: non-fast-forward update to $remote_ref is blocked." >&2
        exit 1
      fi ;;
  esac
  has_updates=true
done
if [ "$has_updates" = true ]; then
  cd "$(git rev-parse --show-toplevel)"
  npm run verify
fi
